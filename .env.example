# Set NEON_DATABASE_URL or POSTGRES_URL to your Neon connection string:
NEON_DATABASE_URL="postgresql://user:password@ep-sample-project.us-east-2.aws.neon.tech/neondb?sslmode=require"
POSTGRES_URL=""
DATABASE_URL=""

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@hadidcreatives.com"
ADMIN_PASSWORD="HadidAdmin2026!"
JWT_SECRET="hadid-creatives-super-secret-jwt-key-change-in-production-2026"

# ------------------------------------------------------------------------------
# 3. ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="production"
