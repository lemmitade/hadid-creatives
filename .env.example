# ==============================================================================
# Hadid Creatives - Environment Variables for Vercel & Production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Vercel Postgres / Neon / Supabase)
# ------------------------------------------------------------------------------
# When you connect a database in the Vercel Dashboard (Storage -> Create Database -> Postgres/Neon),
# Vercel will automatically inject POSTGRES_URL. No manual configuration is required!
POSTGRES_URL="postgres://default:password@ep-sample-project.us-east-1.aws.neon.tech/verceldb?sslmode=require"

# Optional standard PostgreSQL connection string fallback
DATABASE_URL=""

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@hadidcreatives.com"
ADMIN_PASSWORD="HadidAdmin2026!"
JWT_SECRET="hadid-creatives-super-secret-jwt-key-change-in-production-2026"

# ------------------------------------------------------------------------------
# 3. ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="production"
